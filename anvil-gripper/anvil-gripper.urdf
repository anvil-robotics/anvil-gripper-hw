  <joint name="wrist_cam_joint" type="fixed">
    <origin xyz="0.074 0.001 0.009" rpy="-0.8255 0 1.5708" />
    <parent link="hand" />
    <child link="wrist_cam" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="0" effort="0" velocity="0" />
  </joint>
  <joint name="finger_joint1" type="prismatic">
    <origin xyz="0 -0.006 0.015" rpy="0 0 0" />
    <parent link="hand" />
    <child link="right_finger" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0.05" effort="10" velocity="1" />
    <dynamics damping="60.5" friction="9.26" />
  </joint>
  <joint name="finger_joint2" type="prismatic">
    <origin xyz="0 0.006 0.015" rpy="0 0 0" />
    <parent link="hand" />
    <child link="left_finger" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.05" effort="10" velocity="1" />
    <mimic joint="finger_joint1" />
  </joint>
  <joint name="hand_tcp_joint" type="fixed">
    <origin xyz="0 0 0.08" rpy="0 0 0" />
    <parent link="hand" />
    <child link="hand_tcp" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="0" effort="0" velocity="0" />
  </joint>
